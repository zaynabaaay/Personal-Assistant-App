{
  "name": "personal-assistant-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "ios:device": "RUBYLIB=\"$PWD/scripts\" RUBYOPT=-rcocoapods-utf8 LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 PATH=\"$HOME/.rubies/ruby-3.3.12-expo/bin:$PATH\" expo run:ios --device",
    "web": "expo start --web",
    "predeploy": "expo export --platform web",
    "deploy": "gh-pages --nojekyll -d dist",
    "test:assistant": "tsx --test tests/assistant-backend.test.mjs",
    "test:calendar": "tsx --test tests/calendar-service.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint"
  },
  "dependencies": {
    "expo": "~57.0.12",
    "expo-calendar": "~57.0.1",
    "expo-constants": "~57.0.10",
    "expo-dev-client": "~57.0.7",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.12",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "gh-pages": "^6.3.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3"
  }
}
